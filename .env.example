# Database configuration
# Local Docker: postgresql://postgres:postgres@localhost:5435/tfs_db?schema=public
# Production Neon: postgresql://username:password@ep-xyz.us-east-2.aws.neon.tech/tfs_db?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/tfs_db?schema=public"

# Admin Authentication & Security (generate with: openssl rand -base64 32)
JWT_SECRET="your_strong_jwt_secret_change_in_production"

# Public Store Configuration
NEXT_PUBLIC_STORE_NAME="THE FITNESS STORE"
NEXT_PUBLIC_STORE_TAGLINE="Wholesaler & Retailer of Sports & Fitness Goods"
NEXT_PUBLIC_WHATSAPP_NUMBER="919876543210"
NEXT_PUBLIC_CONTACT_EMAIL="support@thefitnessstore.com"
NEXT_PUBLIC_CONTACT_PHONE="+91 98765 43210"
NEXT_PUBLIC_STORE_ADDRESS="Shop 12, Prime Fitness Hub, MG Road, Commercial Plaza, India"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Initial Admin Credentials (used only during initial seed)
ADMIN_INITIAL_EMAIL="admin@thefitnessstore.com"
